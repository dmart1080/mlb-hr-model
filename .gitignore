cython_debug/

# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Project data + outputs (don't commit large/generated files)
data/cache/
data/processed/*
data/backtest/
logs/

# Prediction CSVs ARE tracked — the nightly isotonic recalibrator reads them.
# Each file is ~50 KB; a full season accumulates ~15 MB.
# (no ignore rule for data/predictions/)

# Slim carry-forward train table IS tracked — generated locally after each
# monthly retrain (run scripts/export_slim_table.py) so GitHub Actions can
# run build_today_features without the full multi-GB history file.
!data/processed/train_table_slim_90d.parquet

models/train_runs.csv
